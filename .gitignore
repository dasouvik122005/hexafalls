# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only the SOPS-encrypted .env and the .env.example template
# are committed. Everything else (.env.local, .env.development.local, etc.)
# stays local.
.env*
!.env
!.env.example

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler
.dev.vars
.dev.vars.local
cloudflare-env.d.ts

# sops / age — never commit private age keys
*.age.key
keys.txt

# typescript
*.tsbuildinfo
next-env.d.ts
