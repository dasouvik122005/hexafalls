{
  "name": "hexafalls",
  "version": "1.0.24",
  "private": true,
  "description": "HexaFalls — a 58-hour wizarding-themed hackathon at JIS University, Kolkata. Next.js + Tailwind app deployed on Cloudflare via OpenNext.",
  "keywords": [
    "hexafalls",
    "hackathon",
    "techfest",
    "jis-university",
    "gdg",
    "kolkata",
    "nextjs",
    "tailwindcss",
    "cloudflare",
    "opennext"
  ],
  "homepage": "https://hexafalls.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexafest/hexafalls.git"
  },
  "bugs": {
    "url": "https://github.com/hexafest/hexafalls/issues"
  },
  "author": {
    "name": "Ayushman Bhattacharya (@elixpo)",
    "email": "ayushman@myceli.ai",
    "url": "https://github.com/Circuit-Overtime"
  },
  "contributors": [
    {
      "name": "GDG on Campus · JIS University",
      "url": "https://gdg.community.dev/gdg-on-campus-jis-university-kolkata-india/"
    }
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "optimize:logos": "node scripts/optimize-logos.mjs",
    "optimize:brochure": "node scripts/optimize-brochure.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "secrets:init": "bash scripts/secrets.sh init",
    "secrets:encrypt": "bash scripts/secrets.sh encrypt",
    "secrets:decrypt": "bash scripts/secrets.sh decrypt",
    "secrets:edit": "bash scripts/secrets.sh edit"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.3",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "wrangler": "^4.87.0"
  }
}
